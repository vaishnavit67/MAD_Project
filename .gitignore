# ==============================================================================
# Git Ignore Configuration for Campus Connect
# Prevents any credentials, tokens, secrets, private keys, or personal uploads
# from ever being tracked in version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.keystore
*.jks
*credentials*.json
*secret*.json
key.properties
**/android/key.properties
**/local.properties
**/android/local.properties

# Firebase Configuration & Google Services Credentials
lib/firebase_options.dart
**/firebase_options.dart
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
firebase-debug.log*

# ------------------------------------------------------------------------------
# 2. Local Database & Cache Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.rdb
*.dump
*.box
*.hive
*.lock
!pubspec.lock
!package-lock.json

# ------------------------------------------------------------------------------
# 3. Backend Uploads, Dependencies & Logs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
backend/dist/
backend/build/
backend/uploads/*
!backend/uploads/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. Flutter / Dart / Pub
# ------------------------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Studio & Build Artifacts
/android/app/debug
/android/app/profile
/android/app/release
android/.gradle/
android/app/build/
android/captures/

# iOS / macOS Pods & Frameworks
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/ServiceDefinitions.json
*.mobileprovision

# ------------------------------------------------------------------------------
# 5. IDE & Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
*.class
*.log
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
.vscode/
.widget_preview/